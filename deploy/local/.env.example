AIMEC_PLATFORM_PORT=8000
WORLD_MODEL_PORT=8001
NIMBLE_PORT=8002
TIMESFM_PORT=8003
AGENT_COMPUTER_PORT=8004

# Override these with locally built tags when GHCR images are unavailable.
AIMEC_PLATFORM_IMAGE=ghcr.io/aimeclabs/aimec-intelligence-platform:latest
WORLD_MODEL_IMAGE=ghcr.io/aimeclabs/world-model:latest
NIMBLE_IMAGE=ghcr.io/aimeclabs/aimec-nimble-engine:latest
TIMESFM_IMAGE=ghcr.io/aimeclabs/timesfm-engine:latest
AGENT_COMPUTER_IMAGE=ghcr.io/aimeclabs/aimec-agent-computer:latest

# Local Ollama remains on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
